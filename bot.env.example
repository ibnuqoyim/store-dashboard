# ─── WhatsApp Bot Configuration ───────────────────────────────────────────────

# Comma-separated list of WhatsApp numbers allowed to interact with the bot
# Format: country code + number (no +, no spaces, no dashes)
# Example: 628123456789,628987654321
ALLOWED_WA_NUMBERS=628123456789

# Super admins — can create and update stores from the bot.
# These numbers bypass the store whitelist check (useful before any store exists).
# Format: same as ALLOWED_WA_NUMBERS
SUPER_ADMIN_PHONES=628123456789

# Path to store WhatsApp session files (QR scan result)
WA_SESSION_PATH=bot/session

# ─── AI Provider ──────────────────────────────────────────────────────────────

# Choose one: ollama | openrouter | claude | openai
AI_PROVIDER=ollama

# System prompt for the AI assistant (optional - has default in Indonesian)
# SYSTEM_PROMPT=Kamu adalah asisten toko roti sourdough bernama Sourdoughmu_ya...

# Max number of messages to keep in conversation history per user
# MAX_HISTORY_MESSAGES=20

# ─── Ollama (local, no API key needed) ────────────────────────────────────────

# Default: http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Default: llama3.2 — run `ollama list` to see available models
# OLLAMA_MODEL=llama3.2

# ─── OpenRouter (cloud, many models) ──────────────────────────────────────────

# Get your API key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Model slug from OpenRouter (e.g. google/gemma-3-27b-it:free)
# OPENROUTER_MODEL=google/gemma-3-27b-it:free
# OPENROUTER_SITE_NAME=Sourdoughmu_ya Bot

# ─── Claude (Anthropic) ───────────────────────────────────────────────────────

# Get your API key at https://console.anthropic.com/
# CLAUDE_API_KEY=sk-ant-...

# Default: claude-haiku-4-5-20251001 (fast & cheap)
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── OpenAI ───────────────────────────────────────────────────────────────────

# Get your API key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Default: gpt-4o-mini (fast & cheap)
# OPENAI_MODEL=gpt-4o-mini

# ─── Supabase (required for bot tools: /order, /resume, /cari, /po) ──────────

# Supabase project URL (same as NEXT_PUBLIC_SUPABASE_URL in dashboard .env)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Service role key — bypasses RLS, keep secret, never expose to browser
# Found in: Supabase dashboard → Settings → API → service_role
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# ─── Cloudinary (required for /store baru logo upload) ───────────────────────

# Found in: Cloudinary dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
